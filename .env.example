# --- домен и Traefik (сервис ставится за существующий Traefik) ---
REC_DOMAIN=rec.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
WHISPER_CPUS=2

# --- доступ с часов: тот же токен вшивается в APK часов (openssl rand -hex 24) ---
UPLOAD_TOKEN=

# --- веб-архив и приложение на телефон ---
WEB_PASSWORD=              # пароль входа
WEB_SECRET=                # подпись сессий: openssl rand -hex 32
WEB_URL=https://rec.example.com
# ANDROID_CERT_SHA256=     # отпечаток ключа подписи телефона — ссылки из Telegram открываются в приложении

# --- Telegram: сводки, напоминания ---
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_REMINDERS=1             # 0 — напоминания только в приложении на телефоне

# --- распознавание: api (OpenAI-совместимый) или local (faster-whisper на своём CPU) ---
STT_MODE=api
STT_API_URL=https://api.openai.com/v1
STT_API_KEY=
STT_API_MODEL=gpt-4o-transcribe     # mini дешевле, но путает имена и термины
STT_CHUNK_SEC=300                   # длинные записи режутся на куски (лимит API 25 МБ)
STT_CLEAN=1                         # усиление/шумодав перед распознаванием: микрофон часов тихий
LANGUAGE=ru
# для STT_MODE=local:
WHISPER_MODEL=medium
WHISPER_COMPUTE=int8
WHISPER_THREADS=2

# --- сводка и задачи: anthropic | openai | none ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# для openai-совместимых:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
MIN_WORDS_FOR_SUMMARY=40
EMPTY_DROP_SEC=5                    # пустые записи короче — удаляются молча
